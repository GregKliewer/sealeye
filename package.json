{
  "name": "sealeye",
  "version": "2.46.3",
  "private": true,
  "description": "seaLeye.run: bring your app, get a plan you can read, and on yes a real environment.",
  "license": "AGPL-3.0-only",
  "author": "OpMo Advisory Inc.",
  "homepage": "https://sealeye.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GregKliewer/sealeye.git"
  },
  "type": "module",
  "bin": {
    "sealeye": "./cli/bin/sealeye"
  },
  "files": [
    "cli/",
    "core/",
    "npm-shrinkwrap.json",
    "prompts/banner.txt",
    "prompts/module-catalog.yaml",
    "prompts/plan-template.md",
    "prompts/refusal.md",
    "templates/http_api_serverless.yaml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node api/server.js",
    "dev": "node --watch api/server.js",
    "cli": "node cli/bin/sealeye",
    "test": "node --test test/*.test.js",
    "eval:interview": "node scripts/eval-interview.js",
    "eval:discovery": "node scripts/eval-discovery.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.6",
    "@langfuse/core": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "ignore": "^7.0.12",
    "pg": "^8.23.1",
    "yaml": "^2.8.4"
  }
}
