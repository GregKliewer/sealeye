# Caddy obtains a certificate for each address below as soon as its DNS points here
# (PHASE1-PLAN Step 12, D6). The pages are files in /srv, sent by deploy/release.sh;
# the API is the container next door.

{$API_DOMAIN} {
	encode gzip
	# An interview streams for minutes and uploads can be large: no time limit on the
	# stream, and Caddy passes server-sent events through as they are written.
	reverse_proxy api:3000 {
		flush_interval -1
	}
}

# seaLeye.online: the portal (portal/, built by release.sh), and the API under /api on
# the same origin, so the portal's session cookie never crosses to another site
# (DESIGN.md, "The portal signs in with a session cookie").
{$PORTAL_DOMAIN} {
	encode gzip

	handle_path /api/* {
		# The API answers JSON. Should it ever answer anything else on the portal's
		# origin, the browser renders none of it as a page.
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy same-origin
			Strict-Transport-Security "max-age=31536000"
		}
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		# Only this site's own scripts run here, and nothing may frame it: the defence
		# that makes a cookie no script can read worth having.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			X-Frame-Options DENY
			Strict-Transport-Security "max-age=31536000"
		}
		root * /srv/online
		# An asset is named for its contents, so a browser may keep it for good. One that
		# is not here is a 404, never the portal's page under an asset's name, which a
		# browser would keep for a year and try to run as a script.
		@asset {
			path /assets/*
			file
		}
		handle @asset {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		@missingAsset path /assets/*
		handle @missingAsset {
			header Cache-Control "no-store"
			respond 404
		}
		# The portal's own pages (/catalog, /environments/...) are one app.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}

# seaLeye.run: the command's home page, its installer and the package it installs.
{$RUN_DOMAIN} {
	encode gzip
	root * /srv/run
	@installer path /install /install.sh
	header @installer {
		Content-Type "text/plain; charset=utf-8"
		Cache-Control "no-cache"
	}
	rewrite /install /install.sh
	file_server
}

www.{$PORTAL_DOMAIN} {
	redir https://{$PORTAL_DOMAIN}{uri} permanent
}

# sealeye.org is served by GitHub Pages, not here (DESIGN.md).
www.{$RUN_DOMAIN} {
	redir https://{$RUN_DOMAIN}{uri} permanent
}
