#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import readline from "node:readline/promises";
import { fileURLToPath } from "node:url";

import {
  loadPlanFromYaml,
  createDeployment,
  validatePlan,
  getDeployment,
  listDeployments,
  destroyDeployment
} from "../lib/run.js";
import { banner, step, ask, answer, c, product } from "../src/brand.js";
import { runInterview, resolveApiKey } from "../src/interview/loop.js";
import { writeInterviewFiles } from "../src/interview/render.js";

// --json is machine output: no banner, no colour, nothing but the object.
const jsonOut = process.argv.includes("--json");

// Everything the CLI reads is found relative to the CLI itself, never to the
// developer's folder.
const cliDir = path.dirname(fileURLToPath(import.meta.url));
const repoRoot = path.resolve(cliDir, "..", "..");

function version() {
  try {
    const pkg = JSON.parse(fs.readFileSync(path.join(cliDir, "..", "package.json"), "utf8"));
    return `v${pkg.version}`;
  } catch {
    return "";
  }
}

// One plain-language line of what the platform is doing. Silent in --json mode, which
// must stay parseable.
function say(line) {
  if (!jsonOut) console.log(step(line));
}

// Printed once at the top of every command.
function printBanner() {
  if (jsonOut) return;
  try {
    console.log(banner(fs.readFileSync(path.join(repoRoot, "prompts", "banner.txt"), "utf8"), version()));
  } catch {
    console.log(`${c.accent(product.name)}\n`);
  }
}

function usage() {
  console.log(`
${product.command} - deploy your app to a real AWS environment

Usage:
  ${product.command} init [--api <url>]
  ${product.command} deploy --file <plan.yaml> [--app <path>] [--api <url>] [--json]
  ${product.command} validate --file <plan.yaml> [--api <url>] [--json]
  ${product.command} status <deploymentId> [--api <url>] [--json]
  ${product.command} watch <deploymentId> [--api <url>]
  ${product.command} destroy <deploymentId> [--api <url>]
  ${product.command} list [--all] [--api <url>] [--json]

Options:
  -f, --file      path to your plan YAML
      --app       folder to deploy (default: the current folder)
  -b, --backend   cloudformation (default: cloudformation)
      --all       with list: include environments you have torn down
      --api       platform API base URL (default: http://localhost:3000)
      --json      machine-readable output
  -h, --help      show help

Examples:
  ${product.command} init
  ${product.command} validate -f plan.yaml
  ${product.command} deploy -f plan.yaml
  ${product.command} watch dep_1a2b3c4d5e6f
  ${product.command} list
  ${product.command} destroy dep_1a2b3c4d5e6f
`);
}

function getArg(longFlag, shortFlag) {
  const argv = process.argv;
  const iLong = argv.indexOf(longFlag);
  if (iLong !== -1) return argv[iLong + 1];
  if (shortFlag) {
    const iShort = argv.indexOf(shortFlag);
    if (iShort !== -1) return argv[iShort + 1];
  }
  return undefined;
}

async function main() {
  const [, , command] = process.argv;

  printBanner();

  if (!command || command === "-h" || command === "--help") {
    usage();
    process.exit(0);
  }

  const apiBaseUrl = getArg("--api") || "http://localhost:3000";

  if (command === "init") {
    // init runs in the app folder, and that folder is the only one it ever touches.
    const appPath = process.cwd();

    if (!resolveApiKey()) {
      console.error(
        c.fail("ANTHROPIC_API_KEY is not set, so seaLeye.run cannot interview you about your app.")
      );
      console.error(`  Set it in your environment, or put it in ${path.join("~", ".deployme", "config")}, then run ${product.command} init again.`);
      process.exit(1);
    }

    // init is a conversation, so it needs somebody at a terminal to have it with.
    if (!process.stdin.isTTY) {
      console.error(c.fail(`${product.command} init asks you questions, so it needs a terminal.`));
      console.error(`  Run it yourself in your app folder, or deploy an existing plan with ${product.command} deploy -f deployme.yaml.`);
      process.exit(1);
    }

    say("Reading your app");

    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    let result;

    try {
      result = await runInterview({
        appPath,
        apiBaseUrl,
        onStep: say,
        // One question at a time, amber, with whatever the platform found above it.
        ask: async (question, lead = []) => {
          console.log("");
          for (const line of lead) console.log(step(line));

          const reply = (await rl.question(ask(question))).trim();
          console.log(`  ${answer(reply || "(no answer)")}`);

          return reply;
        }
      });

      if (result.status === "invalid") {
        console.log("");
        console.log(c.fail("seaLeye.run could not write a plan that fits its own contract:"));
        for (const e of result.errors || []) console.log(`  ${e.message}`);
        say("Nothing has been written to your folder.");
        process.exitCode = 1;
        return;
      }

      if (result.status !== "submitted") {
        console.log("");
        console.log(result.message);
        say("Nothing has been written to your folder.");
        return;
      }

      // The plan is valid. These two files are the only thing written before the
      // developer says yes.
      const { planPath, configPath } = writeInterviewFiles(appPath, result);

      console.log("");
      console.log(result.summary);
      console.log("");
      say(`Wrote ${planPath}`);
      say(`Wrote ${configPath}`);
      console.log("");

      const reply = (await rl.question(ask("Deploy this? [y/N]"))).trim();
      console.log(`  ${answer(reply || "N")}`);

      if (reply.toLowerCase() !== "y") {
        console.log("");
        say(`Your plan is in ${planPath}, and the plan seaLeye.run would run is in ${configPath}`);
        say(`When you are ready: ${product.command} deploy -f ${path.basename(configPath)}`);
        process.exit(0);
      }
    } finally {
      rl.close();
    }

    const deployment = await runDeploy({
      apiBaseUrl,
      backend: "cloudformation",
      plan: result.plan,
      appPath,
      follow: false
    });

    await runWatch({ apiBaseUrl, deploymentId: deployment.deploymentId });

    return;
  }

  if (command === "validate") {
    const file = getArg("--file", "-f");
    if (!file) {
      console.error(c.fail(`Missing required --file: ${product.command} validate --file <plan.yaml>`));
      process.exit(1);
    }

    say(`Reading your plan from ${file}`);
    const plan = loadPlanFromYaml(file);

    say("Checking it against the seaLeye.run plan contract");
    const result = await validatePlan({ apiBaseUrl, plan });

    if (jsonOut) {
      console.log(JSON.stringify(result, null, 2));
    } else if (result.valid) {
      console.log(c.ok("Your plan is valid"));
    } else {
      console.log(c.fail("Your plan cannot be deployed as written:"));
      for (const e of result.errors || []) console.log(`  ${e.message}`);
      process.exitCode = 1;
    }

    return;
  }

  if (command === "deploy") {
    const file = getArg("--file", "-f");
    if (!file) {
      console.error(c.fail(`Missing required --file: ${product.command} deploy --file <plan.yaml>`));
      process.exit(1);
    }

    const backend = getArg("--backend", "-b") || "cloudformation";
    const appPath = path.resolve(getArg("--app") || process.cwd());

    say(`Reading your plan from ${file}`);
    const plan = loadPlanFromYaml(file);

    await runDeploy({ apiBaseUrl, backend, plan, appPath });

    return;
  }

  if (command === "status") {
    const deploymentId = process.argv[3];

    if (!deploymentId) {
      console.error(c.fail(`Missing deploymentId: ${product.command} status <deploymentId>`));
      process.exit(1);
    }

    const result = await getDeployment({ apiBaseUrl, deploymentId });

    if (jsonOut) console.log(JSON.stringify(result, null, 2));
    else printDeploymentSummary(result);

    return;
  }

  if (command === "list") {
    const all = process.argv.includes("--all");
    const everything = await listDeployments({ apiBaseUrl });

    // Torn-down environments are history, not something you can still open.
    const shown = all ? everything : everything.filter(d => d.status !== "destroyed");
    const hidden = everything.length - shown.length;

    if (jsonOut) {
      console.log(JSON.stringify(shown, null, 2));
      return;
    }

    if (!shown.length) {
      say(hidden ? `No live environments (${hidden} torn down — see --all)` : "No deployments yet");
      return;
    }

    printDeploymentTable(shown);
    if (hidden) say(`${hidden} torn down and hidden — see --all`);
    return;
  }

  if (command === "destroy") {
    const deploymentId = process.argv[3];
    if (!deploymentId) {
      console.error(c.fail(`Missing deploymentId: ${product.command} destroy <deploymentId>`));
      process.exit(1);
    }

    say(`Asking seaLeye.run to tear down ${deploymentId}`);
    const started = await destroyDeployment({ apiBaseUrl, deploymentId });

    if (jsonOut) {
      console.log(JSON.stringify(started, null, 2));
      return;
    }

    let lastStep = null;

    while (true) {
      const dep = await getDeployment({ apiBaseUrl, deploymentId });

      // Each new plain-language line once, as it happens.
      if (dep.step && dep.step !== lastStep) {
        say(dep.step);
        lastStep = dep.step;
      }

      if (dep.status === "destroyed") {
        console.log("");
        console.log(c.ok(`Everything seaLeye.run created for ${dep.app?.name} is gone`));
        if (dep.note) say(dep.note);
        if (dep.removedArtifacts?.length) say(`Removed ${dep.removedArtifacts.length} local build file(s)`);
        break;
      }

      if (dep.status === "failed") {
        console.log("");
        console.log(c.fail(`Tear-down failed: ${dep.failureReason || "no reason reported"}`));
        process.exitCode = 1;
        break;
      }

      await sleep(1000);
    }

    return;
  }

  if (command === "watch") {
    const deploymentId = process.argv[3];
    if (!deploymentId) {
      console.error(c.fail(`Missing deploymentId: ${product.command} watch <deploymentId>`));
      process.exit(1);
    }

    await runWatch({ apiBaseUrl, deploymentId });

    return;
  }

  console.error(c.fail(`Unknown command: ${command}`));
  usage();
  process.exit(1);
}

// Hand a plan and a folder to the platform. `deploy` and `init` both come through
// here: init has no deployment logic of its own.
async function runDeploy({ apiBaseUrl, backend, plan, appPath, follow = true }) {
  say(`Handing ${appPath} to seaLeye.run to build your environment`);
  const result = await createDeployment({ apiBaseUrl, backend, plan, appPath });

  if (jsonOut) {
    console.log(JSON.stringify(result, null, 2));
    return result;
  }

  console.log("");
  printDeploymentSummary(result);
  console.log("");
  console.log(`Deployment id: ${c.accent(result.deploymentId)}`);
  if (follow) say(`Follow it with: ${product.command} watch ${result.deploymentId}`);

  return result;
}

// Follow a deployment to its real end state, redrawing twice a second.
async function runWatch({ apiBaseUrl, deploymentId }) {
  const formatDots = tick => ".".repeat((tick % 3) + 1);   // 1..3
  let tick = 0;

  while (true) {
    const dep = await getDeployment({ apiBaseUrl, deploymentId });
    const dots = formatDots(tick++);

    // Redraw: the banner stays at the top of the screen, the summary under it.
    console.clear();
    printBanner();
    printDeploymentSummary(dep);
    console.log("");
    process.stdout.write(c.dim(`Status: ${dep.status}${dots}`));

    if (dep.status === "succeeded" || dep.status === "failed") {
      process.stdout.write("\n\n");

      if (dep.status === "succeeded") {
        const url = publicUrl(dep);
        console.log(c.ok(url ? `Your app is live at ${url}` : "Your environment is ready"));
        writeReport(dep);
      } else {
        console.log(c.fail(failureSentence(dep)));
        if (dep.rolledBackStackRemoved) {
          say("The half-built stack has been removed, so you can fix the plan and deploy again");
        }
        process.exitCode = 1;
      }

      return dep;
    }

    await sleep(500); // refresh twice per second
  }
}

// Why the deployment failed, in one sentence. CloudFormation reasons arrive with
// newlines and double spaces in them; left alone they read like a stack trace.
function failureSentence(dep) {
  const reason = (dep.failureReason || "").replace(/\s+/g, " ").trim().replace(/\.$/, "");
  return reason
    ? `Your environment was not created: ${reason}.`
    : "Your environment was not created, and AWS did not say why.";
}

// The one URL the developer asked for: the API's or the static site's.
function publicUrl(dep) {
  return dep.outputs?.ApiUrl || dep.outputs?.WebsiteUrl || null;
}

// The report is the only thing the platform writes into the developer's folder.
function writeReport(dep) {
  if (!dep.report) {
    say("No report was returned for this deployment");
    return;
  }

  const reportPath = path.join(process.cwd(), "DEPLOYMENT_REPORT.md");
  fs.writeFileSync(reportPath, dep.report);
  say(`Wrote ${reportPath}`);
}

function statusColour(status, text = status) {
  if (status === "succeeded") return c.accent(text);
  if (status === "failed") return c.prompt(text);
  return c.dim(text);
}

// Pad before colouring: escape codes have width on the page but not on the screen.
const pad = (s, n) => s + " ".repeat(Math.max(0, n - s.length));

function printDeploymentTable(deployments) {
  const rows = deployments.map(dep => ({
    dep,
    id: dep.deploymentId,
    app: dep.app?.name || "-",
    // An interrupted record is the last status we knew, not a live one. Say so.
    status: dep.interrupted ? `${dep.status} (interrupted)` : dep.status,
    url: publicUrl(dep) || "-"
  }));

  const widthOf = key => Math.max(...rows.map(r => r[key].length));
  const w = {
    id: Math.max("ID".length, widthOf("id")),
    app: Math.max("APP".length, widthOf("app")),
    status: Math.max("STATUS".length, widthOf("status"))
  };

  console.log(c.dim(`${pad("ID", w.id)}  ${pad("APP", w.app)}  ${pad("STATUS", w.status)}  URL`));

  for (const r of rows) {
    const status = r.dep.interrupted
      ? c.prompt(pad(r.status, w.status))
      : statusColour(r.dep.status, pad(r.status, w.status));
    const url = r.url === "-" ? c.dim(r.url) : c.accent(r.url);

    console.log(`${pad(r.id, w.id)}  ${pad(r.app, w.app)}  ${status}  ${url}`);
  }
}

function printDeploymentSummary(dep) {
  const row = (label, value) => console.log(`${label.padEnd(12)}${value}`);

  row("Deployment:", dep.deploymentId);
  row("Status:", statusColour(dep.status));
  row("App:", `${dep.app?.name} (${dep.app?.type})`);
  if (dep.stackName) row("Stack:", c.dim(`${dep.stackName}${dep.stackStatus ? ` (${dep.stackStatus})` : ""}`));

  const url = publicUrl(dep);
  if (url) row("URL:", c.accent(url));
  if (dep.outputs?.LogGroup) row("Logs:", c.accent(dep.outputs.LogGroup));
  if (dep.outputs?.BucketName) row("Bucket:", c.accent(dep.outputs.BucketName));
  if (dep.startedAt) row("Started:", c.dim(dep.startedAt));
  if (dep.finishedAt) row("Finished:", c.dim(dep.finishedAt));
  if (dep.failureReason) row("Failed:", c.prompt(dep.failureReason));

  if (Array.isArray(dep.resolvedModules) && dep.resolvedModules.length) {
    console.log("You asked for:");
    for (const m of dep.resolvedModules) console.log(`  ${c.accent(m.id)}`);
  }

  // One plain-language line of what the platform is doing right now.
  if (dep.step) console.log(`\n${step(dep.step)}`);
}

async function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

main().catch(err => {
  console.error(c.fail(err.details ? JSON.stringify(err.details, null, 2) : (err.stack || String(err))));
  process.exit(1);
});
